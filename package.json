{
  "name": "bazaar-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "scripts/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "data:build": "npm run build -w @app/data --",
    "data:check": "npm run check -w @app/data --",
    "dev:server": "npm run dev -w @app/server",
    "dev:web": "npm run dev -w @app/web"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
