# Copy to .env (never commit .env).
#   - local runs (npm run dev:server): the server settings below
#   - VPS / Docker Compose (docs/DEPLOY.md): the same file; compose reads it for its own ${...} settings
#     (section "VPS deployment") AND passes it to the container. compose.yaml pins NODE_ENV=production,
#     PORT, HOST and DATABASE_PATH=/data/market.sqlite, so those lines are ignored in the container.

# --- server ---
PORT=8080
NODE_ENV=development
# Path to the read-only SQLite file. Default: <repo>/data/market.sqlite (Docker: /data/market.sqlite).
# If the file is missing the server still starts and /api/health reports db:false.
DATABASE_PATH=data/market.sqlite
# Built web app to serve (default: apps/web/dist; Docker: /app/web).
# WEB_DIST=apps/web/dist

# --- public-endpoint safety ---
# Max /api requests per client IP per minute (/api/health is exempt).
RATE_LIMIT=120
# Max /api/assist requests per client IP per minute (stricter: it may call the LLM and replans).
# ASSIST_RATE_LIMIT=30
# Reverse-proxy hops to trust for the client IP (default: 1 in production, 0 otherwise). Verify after deploy:
# see docs/SECURITY.md (a wrong value merges all clients into one bucket, or lets clients spoof their IP).
# TRUST_PROXY=1

# --- LLM (optional; the product works fully without it). Server-side only, never in the web bundle. ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Per-call budget in ms (default 3000). A late answer is discarded, never swapped in.
# LLM_TIMEOUT_MS=3000
# auto (default: thinking off for claude-haiku-5*, model default otherwise) | off | adaptive
# LLM_THINKING=auto
# Circuit breaker: consecutive failures that open it, and the first cooldown before a half-open probe.
# LLM_BREAKER_THRESHOLD=3
# LLM_BREAKER_COOLDOWN_MS=30000
# Cost / abuse budget of LLM calls (/api/parse refinement + /api/assist); beyond it the answer is deterministic.
# Per client IP per minute (0 = LLM path off), per client IP per UTC day, whole instance per UTC day, in flight.
# LLM_RATE_LIMIT=10
# LLM_DAILY_PER_IP=150
# LLM_DAILY_GLOBAL=3000
# LLM_MAX_CONCURRENCY=4
# Backend: anthropic | claude-cli | none (default: anthropic when LLM_API_KEY is set, else none; none = kill switch).
# LLM_BACKEND=

# --- claude-cli: TESTING ONLY (local headless Claude Code sessions, the developer's own login; docs/SECURITY.md §5) ---
# Never the default: needs LLM_BACKEND=claude-cli. Refused under NODE_ENV=production unless LLM_ALLOW_CLI_IN_PROD=1.
# Defaults for this backend: LLM_TIMEOUT_MS=20000 and REQUEST_TIMEOUT_MS=LLM_TIMEOUT_MS+5000 (process start + a turn),
# and HOST=127.0.0.1 (it spends your own Claude subscription; set HOST=0.0.0.0 only to test from another device).
# LLM_BACKEND=claude-cli
# Absolute path of the claude executable (default: `claude` on PATH, resolved once at start-up).
# LLM_CLI_BIN=/home/<you>/.local/bin/claude
# Model id or alias for the CLI (default: LLM_MODEL, i.e. claude-haiku-5-5).
# LLM_CLI_MODEL=claude-haiku-5-5
# Calls in flight (1-2; beyond, the answer is deterministic and flagged degraded).
# LLM_CLI_CONCURRENCY=1
# LLM_ALLOW_CLI_IN_PROD=0
# Live check (about 10 CLI calls): LLM_BACKEND=claude-cli npm run llm:smoke:cli -w @app/server

# --- logging ---
# LOG_LEVEL=info

# --- VPS deployment (Docker Compose only; read by compose.yaml, not by the server) ---
# Where the app is published on the host. Default: loopback only (reach it through the proxy / an SSH tunnel).
# Plain HTTP straight on the VPS IP, no proxy:  APP_BIND=0.0.0.0  and  TRUST_PROXY=0  (see docs/DEPLOY.md).
# APP_BIND=127.0.0.1
# APP_PORT=8080
# Proxy hops in front of the app. Compose default 1 (bundled Caddy, or nginx on the host). 0 when the app is
# published directly. Wrong values break per-IP rate limiting: docs/DEPLOY.md and docs/SECURITY.md section 4.
# TRUST_PROXY=1
# Bundled Caddy (docker compose --profile proxy up -d): your domain => automatic HTTPS; unset => plain HTTP on :80.
# DOMAIN=bazaar.example.com
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# Host directory holding market.sqlite (mounted read-only at /data).
# DATA_DIR=./data
# Container limits.
# APP_MEM_LIMIT=512m
# APP_CPUS=1.0
# Shown as "commit" in /api/health (deploy/remote-up.sh sets it to the deployed commit).
# APP_COMMIT=dev

# --- Docker build args (read by compose as build args too) ---
# Only where Docker Hub is blocked:
# NODE_IMAGE=docker.arvancloud.ir/library/node:22-slim
# OPTIONAL: bake the database into the image at build time instead of mounting ./data. Not the default path.
# DATA_URL=https://example.com/path/market.sqlite.zst
# DATA_SHA256=<sha256 of the asset file>
